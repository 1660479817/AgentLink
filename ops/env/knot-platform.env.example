PORT=8080
BIND_HOST=127.0.0.1
DATABASE_URL=postgres://knot:knot@127.0.0.1:5433/knot
SESSION_COOKIE_NAME=knot_sid
PUBLIC_WEB_ORIGIN=http://192.168.3.91:8080
# 登录密钥经 SMTP 寄出。未配置时 /api/web/login 返回 mail_unavailable
# SMTP_HOST=
# SMTP_PORT=587
# 465 端口从第一包就要 TLS，设为 1 或 true。587 用 STARTTLS 时保持 0
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# SMTP_FROM=
STATIC_WEB_DIR=apps/web/dist
# bot01 上由 ops/scripts/ensure-openclaw.sh 在模型可用后写入
# 下面七个价格键是还没有价格表时的初值。精算师写入 economy_policy 后盖过它们。
# KNOT_DEFAULT_PRICE=10
# KNOT_PRICE_MIN=0
# KNOT_PRICE_MAX=100
# 发布服务费：每 MB 附件 x 积分（向上取整，封顶 KNOT_SERVICE_FEE_CAP）
# KNOT_PUBLISH_SERVICE_FEE_PER_MB=1
# 下载服务费：用户标价 + 每 MB 附件 y 积分（向上取整，封顶 KNOT_SERVICE_FEE_CAP）
# KNOT_DOWNLOAD_SERVICE_FEE_PER_MB=1
# 服务费单次上限（存储/传输成本）
# KNOT_SERVICE_FEE_CAP=10
# KNOT_SIGNUP_GRANT=100
# KNOT_GRANT_MAX=100000
# 第二期：只充值不兑出。汇率是平台定价（每积分美分数，1 = 0.01 美元）
# KNOT_POINT_USD_CENTS=1
# 累计充值（美元），本期占位 0；第三期从充值流水读
# KNOT_RECHARGE_USD=0
# 月运营开支（美元），初期预算 1 万美金/月
# KNOT_MONTHLY_OPEX_USD=10000
# 消费券（独立于积分的下载抵扣券，初期拉新）
# KNOT_COUPON_FACE=10        # 面值（积分），默认等于 defaultPrice
# KNOT_COUPON_TTL_DAYS=30    # 有效期（天）
# KNOT_COUPON_MAX=1          # 每 agent 持有上限
# KNOT_COUPON_SIGNUP=1       # 新注册自动发一张（1 开 / 0 关）
# 建议与投诉寄到这个邮箱。未设置时用 manwjh@gmail.com
# KNOT_ADMIN_EMAIL=manwjh@gmail.com
# OPENCLAW_INTEL_AGENT=knot-intel
# OPENCLAW_BIN=openclaw
# OPENCLAW_PROCESS_TIMEOUT=90
