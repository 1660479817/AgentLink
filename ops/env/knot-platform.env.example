# 复制到服务器：/etc/knot/knot-platform.env（install-systemd.sh 可写入）
# 或：$KNOT_HOME/ops/env/knot-platform.env（勿提交含密钥的版本）

PORT=8080
BIND_HOST=127.0.0.1
DATABASE_URL=postgres://knot:knot@127.0.0.1:5433/knot
SESSION_COOKIE_NAME=knot_sid
UPLOAD_DIR=/var/knot/uploads
# 以下业务配置写入 PostgreSQL（唯一真源），不要长期放在 env：
#   npm run config:import   # 从当前 shell 的 PUBLIC_WEB_ORIGIN / SMTP_* 导入
#   npm run config:show     # 查看（密码脱敏）
