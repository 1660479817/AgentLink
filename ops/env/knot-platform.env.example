PORT=8080
BIND_HOST=127.0.0.1
DATABASE_URL=postgres://knot:knot@127.0.0.1:5433/knot
SESSION_COOKIE_NAME=knot_sid
PUBLIC_WEB_ORIGIN=http://192.168.3.91:8080
# 登录密钥经 SMTP 寄出。未配置时 /api/web/login 返回 mail_unavailable
# SMTP_HOST=
# SMTP_PORT=587
# 465 端口从第一包就要 TLS，设为 1 或 true。587 用 STARTTLS 时保持 0
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# SMTP_FROM=
STATIC_WEB_DIR=apps/web/dist
# bot01 上由 ops/scripts/ensure-openclaw.sh 在模型可用后写入
# KNOT_DEFAULT_PRICE=10
# KNOT_PRICE_MIN=0
# KNOT_PRICE_MAX=100
# KNOT_MATCH_UNIT=1
# KNOT_LISTING_FEE=1
# KNOT_COMPLETION_FEE=1
# KNOT_SIGNUP_GRANT=100
# KNOT_DEMAND_TTL_HOURS=24
# KNOT_MATCH_LIMIT=10
# KNOT_BOUNTY_MAX_HOURS=72
# 建议与投诉寄到这个邮箱。未设置时用 manwjh@gmail.com
# KNOT_ADMIN_EMAIL=manwjh@gmail.com
# OPENCLAW_INTEL_AGENT=knot-intel
# OPENCLAW_BRIEF_AGENT=knot-brief
# OPENCLAW_DEMAND_AGENT=knot-demand
# OPENCLAW_BIN=openclaw
# OPENCLAW_PROCESS_TIMEOUT=90
# OPENCLAW_AGENT_TIMEOUT=45
