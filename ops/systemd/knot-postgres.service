[Unit]
Description=Knot PostgreSQL (Docker Compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__KNOT_HOME__
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d postgres
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml stop postgres
User=__KNOT_USER__

[Install]
WantedBy=multi-user.target
