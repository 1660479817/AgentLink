[Unit]
Description=xknot.si federation hub API (127.0.0.1:5181)
After=network.target
Documentation=file:///opt/xknot/docs/HUB.md

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/xknot
Environment=XKNOT_API_HOST=127.0.0.1
Environment=XKNOT_API_PORT=5181
Environment=XKNOT_DATA_DIR=/opt/xknot/var
Environment=XKNOT_TRUST_PROXY=1
# HTTPS 已启用
Environment=XKNOT_SECURE_COOKIE=1
ExecStart=/usr/bin/node /opt/xknot/server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
