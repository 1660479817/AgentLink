# 一个边缘入口。复制成 sites/<站点>/edge.<域名>.env，再把 <域名> 换成下面的 KNOT_DOMAIN。
#
# 同一个实例可以有多个公网入口（自有域名 + 签发子域），每个入口一份这个文件。
# 它是叠加层：site.env 里的键在这里都能覆盖，没写的沿用 site.env。
#
# 只写「这个入口和别的入口不一样」的项。两个入口的 KNOT_EDGE_WEB_ROOT 与
# KNOT_EDGE_CONF 必须各不相同，否则后推的会覆盖前一个；config.mjs check 会拦住。

# 这个入口的域名。必须与文件名一致，它决定 server_name、证书路径与清单条目。
KNOT_DOMAIN=

# 边缘上放这个入口 WebUI 的目录。
KNOT_EDGE_WEB_ROOT=

# 边缘上的 nginx 站点配置路径。
KNOT_EDGE_CONF=

# 证书与私钥。留空按 KNOT_DOMAIN 推导为 /etc/letsencrypt/live/<域名>/…
KNOT_EDGE_CERT=
KNOT_EDGE_KEY=

# static：首页与 /assets 从边缘磁盘出，只有 /api 与 /help 穿隧道。
# proxy：连首页也回源到实例，页面与接口永远同一次构建，但每个静态文件都要穿隧道。
KNOT_ENTRY_SERVE=static

# self：自己的域名；issued：xknot.si 签发的子域。
KNOT_ENTRY_OWNER=self

# staff：部署脚本推 WebUI；partner：伙伴自己 rsync，部署脚本跳过这个入口。
KNOT_ENTRY_PUBLISHER=staff
