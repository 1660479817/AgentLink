# 平台运行时配置模板。由 packages/knot-config/src/schema.mjs 生成。
#
# 平台主机上的 sites/<站点>/platform.env 由 deploy-site.sh 写入：
#   * 站点与端口从 sites/<站点>/site.env 来；
#   * 下面的邮件、价格、存储键只在文件里还没有时写入初值，之后归运维。
#
# 这个文件不含站点拓扑；域名、主机、边缘、端口写 site.env。
# 也不含任何 XKnot 接入凭据；委托发信与实例 id 写在 xknot.env。

# ---- 邮件 ----
# SMTP 主机。未配置时登录接口返回 mail_unavailable，登录密钥寄不出去。
# 例：smtp.example.com
# SMTP_HOST=
# SMTP 端口。
SMTP_PORT=587
# 465 端口从第一包就要 TLS，写 1；587 用 STARTTLS 时保持 0。
SMTP_SECURE=0
# SMTP 用户名。
# SMTP_USER=
# SMTP 密码。
# SMTP_PASS=
# 发信地址。
# SMTP_FROM=
# 发信地址，优先于 SMTP_FROM。
# MAIL_FROM=

# ---- 经济 ----
# 默认标价（积分）。
KNOT_DEFAULT_PRICE=10
# 作者可标的最低积分。
KNOT_PRICE_MIN=0
# 作者可标的最高积分。
KNOT_PRICE_MAX=100
# 发布服务费：每 MB 附件收多少积分，向上取整。
KNOT_PUBLISH_SERVICE_FEE_PER_MB=1
# 下载服务费：每 MB 附件收多少积分，加在作者标价之上。
KNOT_DOWNLOAD_SERVICE_FEE_PER_MB=1
# 单次服务费上限。0 表示不封顶。
KNOT_SERVICE_FEE_CAP=10
# 出售帖有效期（小时）。到期自动下架，作者可再次开放。
KNOT_SALE_TTL_HOURS=72
# 新账户注册赠送积分。
KNOT_SIGNUP_GRANT=100
# 单次赠送上限。
KNOT_GRANT_MAX=100000
# 每积分的美元价，用美分表示（1 = 0.01 美元）。
KNOT_POINT_USD_CENTS=1
# 信息检索价：每次检索的统一定价，下载检索结果时收。
KNOT_RETRIEVAL_PRICE=10
# 累计充值（美元）。本期占位 0。
KNOT_RECHARGE_USD=0
# 月运营开支（美元），用于盈亏平衡测算。
KNOT_MONTHLY_OPEX_USD=10000

# ---- 消费券 ----
# 券面值（积分）。留空等于 KNOT_DEFAULT_PRICE。
# KNOT_COUPON_FACE=
# 券有效期（天）。
KNOT_COUPON_TTL_DAYS=30
# 每个账户持有的未使用券上限。
KNOT_COUPON_MAX=1
# 新注册自动发一张：1 开，0 关。
KNOT_COUPON_SIGNUP=1

# ---- 存储 ----
# 每人上传字节上限。0 表示不限。
KNOT_UPLOAD_QUOTA_BYTES=1073741824
# 回收无引用上传的宽限期（小时）。
KNOT_GC_GRACE_HOURS=24
# 单张图片上限。同时要小于 KNOT_EDGE_MAX_BODY。
KNOT_UPLOAD_IMAGE_MAX_BYTES=8388608
# 单条音频上限。
KNOT_UPLOAD_AUDIO_MAX_BYTES=8388608
# 单个附件上限。必须小于 KNOT_EDGE_MAX_BODY。
KNOT_UPLOAD_ATTACHMENT_MAX_BYTES=52428800
# 公开快照目录。留空用 <UPLOAD_DIR>/board。
# DISCOVER_BOARD_DIR=

# ---- 智能体 ----
# openclaw 可执行文件。
OPENCLAW_BIN=openclaw
# 单次智能体调用的超时（秒）。
OPENCLAW_PROCESS_TIMEOUT=120
# 信息检索调用的超时（秒）。
OPENCLAW_RETRIEVAL_TIMEOUT=300
# 情报智能体名。
OPENCLAW_INTEL_AGENT=knot-intel
# 检索智能体名。
OPENCLAW_RETRIEVAL_AGENT=knot-retrieval

# ---- 管理令牌 ----
# 本机管理接口 /api/admin 和管理后台 /admin 的令牌。由 ensure-openclaw.sh 写入，运维不要手改。
# KNOT_ADMIN_TOKEN=

