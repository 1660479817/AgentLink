# Instance runtime configuration template. Generated by packages/knot-config/src/schema.mjs.
#
# sites/<site>/platform.env on the instance host is written by deploy-site.sh:
#   * site and port come from sites/<site>/site.env;
#   * the mail, price and storage keys below are only written with initial values when the file lacks them, then owned by ops.
#
# This file holds no site topology; domain, host, entry and port go in site.env.
# Nor any XKnot federation credentials; delegated mailing and the instance id go in xknot.env.

# ---- Mail ----
# SMTP host. When unconfigured the login endpoint returns mail_unavailable and the login key can't be mailed out.
# Example: smtp.example.com
# SMTP_HOST=
# SMTP port.
SMTP_PORT=587
# Port 465 needs TLS from the first packet, write 1; 587 with STARTTLS keeps 0.
SMTP_SECURE=0
# SMTP username.
# SMTP_USER=
# SMTP password.
# SMTP_PASS=
# Sender address.
# SMTP_FROM=
# Sender address, takes priority over SMTP_FROM.
# MAIL_FROM=

# ---- Economy ----
# Default price (points).
KNOT_DEFAULT_PRICE=10
# The lowest points an author may set.
KNOT_PRICE_MIN=0
# The highest points an author may set.
KNOT_PRICE_MAX=100
# Publish service fee: points per MB of attachment, rounded up.
KNOT_PUBLISH_SERVICE_FEE_PER_MB=1
# Download service fee: points per MB of attachment, added on top of the author's price.
KNOT_DOWNLOAD_SERVICE_FEE_PER_MB=1
# Per-charge service fee cap. 0 means no cap.
KNOT_SERVICE_FEE_CAP=10
# Sale-post validity (hours). A sale post = a post/fastpost with a downloadable attachment and a price; zero-price attachment posts don't count as sale posts and don't expire. On expiry it's auto-delisted, the author can reopen it.
KNOT_SALE_TTL_HOURS=72
# Points granted on new-account registration.
KNOT_SIGNUP_GRANT=100
# Single-grant cap.
KNOT_GRANT_MAX=100000
# The USD price per point, in cents (1 = $0.01).
KNOT_POINT_USD_CENTS=1
# Retrieval price: the uniform per-retrieval price, charged when downloading a retrieval result.
KNOT_RETRIEVAL_PRICE=10
# Cumulative top-up (USD). Placeholder 0 this phase.
KNOT_RECHARGE_USD=0
# Monthly operating opex (USD), for break-even calculation.
KNOT_MONTHLY_OPEX_USD=10000

# ---- Coupon ----
# Coupon face value (points). Empty equals KNOT_DEFAULT_PRICE after clamping into [KNOT_PRICE_MIN, KNOT_PRICE_MAX].
# KNOT_COUPON_FACE=
# Coupon validity (days).
KNOT_COUPON_TTL_DAYS=30
# The cap on unused coupons per account.
KNOT_COUPON_MAX=1
# Auto-grant one on new registration: 1 on, 0 off.
KNOT_COUPON_SIGNUP=1

# ---- Storage ----
# Per-person upload byte cap. 0 means unlimited.
KNOT_UPLOAD_QUOTA_BYTES=1073741824
# The grace period (hours) before unreferenced uploads are collected.
KNOT_GC_GRACE_HOURS=24
# Single-image cap. Must also be under KNOT_ENTRY_MAX_BODY.
KNOT_UPLOAD_IMAGE_MAX_BYTES=8388608
# Single-audio cap.
KNOT_UPLOAD_AUDIO_MAX_BYTES=8388608
# Single-attachment cap. Must be under KNOT_ENTRY_MAX_BODY.
KNOT_UPLOAD_ATTACHMENT_MAX_BYTES=52428800
# The public snapshot directory. Empty uses <UPLOAD_DIR>/board.
# DISCOVER_BOARD_DIR=

# ---- Search ----
# The most candidate rows pulled into memory for scoring per search. The index first blocks rows that can't hit; this is the memory wall.
KNOT_SEARCH_CANDIDATES=2000
# The most results returned per search.
KNOT_SEARCH_RESULTS=30
# The query length cap (characters). Overflow truncates, no error.
KNOT_SEARCH_Q_MAX=120
# Search-result cache lifetime (seconds). 0 means no caching. Invalidate immediately on content change.
KNOT_SEARCH_CACHE_TTL=30
# Per-identity search cap per minute. 0 means unlimited.
KNOT_SEARCH_RATE_PER_MIN=120
# How many retrieval requests a single account may submit per hour. 0 means unlimited.
KNOT_RETRIEVAL_RATE_PER_HOUR=10
# How many tasks the retrieval agent processes at once.
KNOT_RETRIEVAL_CONCURRENCY=2
# The most attempts per retrieval task. The count persists with the task and isn't reset on restart.
KNOT_RETRIEVAL_MAX_ATTEMPTS=3
# How many items the final-review queue processes at once. A retrieval produces both a wish and a wishRespond pending-review record at once.
KNOT_REVIEW_CONCURRENCY=2
# Retention days for search_events traces. 0 means keep forever.
KNOT_SEARCH_EVENT_RETENTION_DAYS=90

# ---- Agents ----
# The openclaw executable.
OPENCLAW_BIN=openclaw
# The timeout (seconds) per agent call.
OPENCLAW_PROCESS_TIMEOUT=120
# The timeout (seconds) for retrieval calls.
OPENCLAW_RETRIEVAL_TIMEOUT=300
# The intel agent name.
OPENCLAW_INTEL_AGENT=knot-intel
# The retrieval agent name.
OPENCLAW_RETRIEVAL_AGENT=knot-retrieval

# ---- Admin token ----
# The token for the intranet admin API /api/admin and the admin console /admin. Written by ensure-openclaw.sh; ops shouldn't hand-edit.
# KNOT_ADMIN_TOKEN=
# The intranet address hardcoded in admin console links, e.g. http://192.0.2.10:8080. Empty infers from KNOT_BIND_HOST and the NICs; with multiple NICs or tunnel topologies, hardcode it to still produce an intranet link when loopback-bound.
# Example: http://192.0.2.10:8080
# KNOT_ADMIN_ORIGIN=

