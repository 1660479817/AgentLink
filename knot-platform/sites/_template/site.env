# Knot site configuration.
#
# Usage:
#   mkdir -p sites/<site>
#   cp sites/_template/site.env sites/<site>/site.env
#   edit sites/<site>/site.env for your site
#
# The site directory does not enter the repo (except sites/_template). The deploy script only reads site, host, path and port from here.
# This file is generated by packages/knot-config/src/schema.mjs; do not hand-edit. To change a config item, change the schema then run
#   node ops/scripts/config.mjs template --write
#
# The same file serves both local deployment and xknot.si subdomain deployment.
# One site directory describes exactly one deployment shape: local uses KNOT_ENTRY_ENABLED=0,
# joining an xknot.si subdomain uses KNOT_ENTRY_ENABLED=1.

# ---- Site ----
# Public-facing address. Local only: write http://127.0.0.1:<KNOT_PORT>; after taking an xknot.si subdomain, write the hub-issued https://<label>.xknot.si.
# Example: https://wang.xknot.si
KNOT_PUBLIC_ORIGIN=http://127.0.0.1:8080
# The sub-subdomain issued by xknot.si, shaped <label>.xknot.si. Leave empty for local-only access; when taking a subdomain, match the entry filename.
# Example: wang.xknot.si
KNOT_DOMAIN=
# Which hub the first join submits the application to. Defaults to the federation entry xknot.si; local integration can point at a dev hub.
# Example: https://xknot.si
KNOT_HUB_ORIGIN=https://xknot.si
# The port the Backend listens on, on the instance host.
KNOT_PORT=8080
# The address the Backend binds. Local and entry back-origin both go only local, keep 127.0.0.1; to let machines on the same LAN open the admin console /admin, set it to 0.0.0.0. When bound to loopback, the admin console link generated on the "Mine" page always starts with 127.0.0.1 and won't open when copied to another device; the deploy script warns once when it's public-facing by domain yet loopback-bound.
KNOT_BIND_HOST=127.0.0.1
# The session cookie name. Must differ when several sites run under one domain.
KNOT_SESSION_COOKIE_NAME=knot_sid
# The site admin email. Required; logging in with this email grants platform admin rights; suggestions and complaints also arrive here.
# Example: admin@example.com
KNOT_ADMIN_EMAIL=
# Login session lifetime (days). The cookie and sessions.expires_at use the same value.
KNOT_SESSION_TTL_DAYS=30

# ---- Instance host ----
# local uses the machine's Homebrew Postgres; external uses KNOT_DATABASE_URL and doesn't start a local database.
KNOT_DB_MODE=local
# The connection string when KNOT_DB_MODE=external. May contain a password; treat as a secret.
# Example: postgres://knot:password@db.example.com:5432/knot
KNOT_DATABASE_URL=
# The local Postgres port, offset from the system default 5432.
KNOT_PGPORT=5433
# The local Postgres data directory.
KNOT_PGDATA=$HOME/knot/pgdata
# The local Postgres log file.
KNOT_PGLOG=$HOME/knot/pg.log
# The bin directory of PostgreSQL 16. Apple Silicon Homebrew is /opt/homebrew; Intel changes it to /usr/local/opt/postgresql@16/bin.
KNOT_PG_BIN=/opt/homebrew/opt/postgresql@16/bin
# The upload directory. Empty uses <deploy root>/var/uploads; put it outside the release package so upgrades and rollbacks never touch it.
KNOT_UPLOAD_DIR=
# The backup directory. Empty means undecided (public sites get reminded); write `null` to mean explicitly no backup, no more reminders; both leave the backup task uninstalled. Filling a directory makes deploy-site.sh install the daily 04:15 backup task (launchd or systemd timer).
KNOT_BACKUP_DIR=
# How many recent backups to keep.
KNOT_BACKUP_KEEP=7
# 1 means the backup also collects sites/<site>/: platform.env (SMTP password, admin token), agents/ (agent credentials). Backing up only the database loses email login and agents when switching machines.
KNOT_BACKUP_SITES=1
# Backing up the OpenClaw state directory. auto collects it when $HOME/.openclaw exists; 1 must collect; 0 skip. Only collects config, credentials, and agent workspaces, not cache/browser/npm.
KNOT_BACKUP_OPENCLAW=auto
# auto syncs only when openclaw is installed; 1 must sync; 0 skip.
KNOT_OPENCLAW=auto
# Where systemd units install on a Linux instance host.
KNOT_SYSTEMD_DIR=/etc/systemd/system
# The system account running the Knot Backend on a Linux instance host. Needs permissions on the directories it reads.
KNOT_SERVICE_USER=knot

# ---- Publish from the dev machine ----
# The instance host's ssh target, shaped user@host. Empty means the target is this machine, run deploy-site.sh in place.
# Example: deploy@<instance-host>
KNOT_DEPLOY_SSH=
# The deploy root on the instance host. sites/, releases/, current, var/ all live here; code is under releases/<version>. Empty derives ~/knot/<site> from the site name; one deploy root holds only one site, don't share it with the source repo or another site's directory.
KNOT_DEPLOY_DIR=
# The private key for publishing. Empty uses the ssh default identity.
KNOT_DEPLOY_SSH_KEY=
# The health-check address after deployment. Empty derives from http://<instance host>:<KNOT_PORT>/api/health.
KNOT_DEPLOY_VERIFY_URL=
# How many historical release packages to keep on the instance host. The current version and the rollback target are always kept; the rest are cleared by time.
KNOT_DEPLOY_KEEP=5
# The output directory on the dev machine for build artifacts (release package and checksum). Empty uses <knot-platform>/artifacts.
KNOT_ARTIFACT_DIR=

# ---- Public entry ----
# 1 means this machine pushes the WebUI and nginx config to KNOT_ENTRY_SSH at deploy time; 0 means don't touch the entry host (local only, or the hub has already auto-wired the entry).
KNOT_ENTRY_ENABLED=0
# The entry host's ssh target.
# Example: ec2-user@<entry-host>
KNOT_ENTRY_SSH=
# The private key for pushing pages from the dev machine. Empty uses the ssh default identity or ssh-agent; the entry host usually rejects id_rsa, use a dedicated deploy key, e.g. $HOME/.ssh/<dedicated deploy key>.
KNOT_ENTRY_SSH_KEY=
# The private key for pushing the public snapshot from the instance host; can differ from KNOT_ENTRY_SSH_KEY.
KNOT_ENTRY_PUSH_KEY=$HOME/.ssh/knot-entry-publish
# The directory holding the WebUI on the entry host. Must be written per subdomain: empty falls back to the shared /var/www/knot and overwrites other subdomains on the same machine.
KNOT_ENTRY_WEB_ROOT=/var/www/knot
# The nginx site config path on the entry host. Must be written per subdomain: empty falls back to the shared /etc/nginx/conf.d/knot.conf.
KNOT_ENTRY_CONF=/etc/nginx/conf.d/knot.conf
# The owner of the WebUI directory.
KNOT_ENTRY_WEB_OWNER=nginx:nginx
# The reverse-proxy cache directory for uploaded files.
KNOT_ENTRY_CACHE_DIR=/var/cache/nginx/knot_uploads
# The nginx proxy_cache zone name.
KNOT_ENTRY_CACHE_ZONE=knot_uploads
# The cache cap, in nginx syntax, e.g. 2g.
KNOT_ENTRY_CACHE_SIZE=2g
# The request-body cap the entry host accepts. Must exceed the backend attachment cap, or large files get truncated at nginx.
KNOT_ENTRY_MAX_BODY=52m
# The entry access log. Subdomains on the same entry host share one file, split by $host; the hub's traffic aggregation reads it.
KNOT_ENTRY_ACCESS_LOG=/var/log/nginx/knot-access.log
# The entry back-origin port. nginx forwards /api here, and the tunnel forwards it back to the instance host.
KNOT_ENTRY_PROXY_PORT=18080
# 1 listens on 443 and configures the certificate; 0 listens on 80 only, used when the certificate isn't signed yet.
KNOT_ENTRY_SSL=1
# The certificate chain. Empty derives from KNOT_DOMAIN.
KNOT_ENTRY_CERT=
# The certificate private key. Empty derives from KNOT_DOMAIN.
KNOT_ENTRY_KEY=
# The reload command after changing the nginx config. Non-systemd machines change it to their own.
KNOT_ENTRY_RELOAD_CMD="sudo systemctl reload nginx"

# ---- Back-origin tunnel ----
# 1 means the instance host dials out to build the tunnel, so the xknot.si subdomain entry can reach back. Leave 0 with no entry; when local also takes a subdomain, sites/<site>/tunnel.env writes 1.
KNOT_TUNNEL=0
# The tunnel account. Empty is knot-tunnel@<KNOT_ENTRY_SSH's host>.
KNOT_TUNNEL_SSH=
# The private key for building the tunnel on the instance host. Relative paths resolve from the site directory (sites/<site>/); the auto-wired tunnel.env uses tunnel_ed25519.
KNOT_TUNNEL_KEY=$HOME/.ssh/knot-entry
# The port the tunnel lands on locally. Empty equals KNOT_PORT.
KNOT_TUNNEL_LOCAL_PORT=
# The port the tunnel occupies on the entry host. Empty equals KNOT_ENTRY_PROXY_PORT.
KNOT_TUNNEL_REMOTE_PORT=

