# Knot 站点配置。
#
# 用法：
#   mkdir -p sites/<站点>
#   cp sites/_template/site.env sites/<站点>/site.env
#   按自己的站点改 sites/<站点>/site.env
#
# 站点目录不进版本库（sites/_template 除外）。部署脚本只从这里读站点、主机、路径和端口。
# 这份文件由 packages/knot-config/src/schema.mjs 生成，不要手改；改配置项请改 schema 后跑
#   node ops/scripts/config.mjs template --write
#
# 同一个文件既给 local 部署用，也给 xknot.si 子域部署用。
# 一个站点目录只描述一种部署方式：local 用 KNOT_ENTRY_ENABLED=0，
# 接入 xknot.si 子域用 KNOT_ENTRY_ENABLED=1。

# ---- 站点 ----
# 对外访问地址。只在本机时写 http://127.0.0.1:<KNOT_PORT>；接 xknot.si 子域后写中枢签发的 https://<标签>.xknot.si。
# 例：https://wang.xknot.si
KNOT_PUBLIC_ORIGIN=http://127.0.0.1:8080
# xknot.si 签发的二级子域，形如 <标签>.xknot.si。只在本机访问时留空；接子域时与入口文件名一致。
# 例：wang.xknot.si
KNOT_DOMAIN=
# 第一次接入时把申请提交到哪个中枢。默认联邦入口 xknot.si；本机联调可以指向 dev 中枢。
# 例：https://xknot.si
KNOT_HUB_ORIGIN=https://xknot.si
# 接入之后 Backend 主动向中枢拉接通进度的间隔（秒）。中枢在实例在 NAT 后拨不进来，所以由这一侧连出去；拿到账号与端口后自己写 tunnel.env 并重启隧道，不必等人打开管理页。0 表示关闭，只在管理页里手动拉。
KNOT_XKNOT_POLL_SECONDS=60
# 实例主机上 Backend 监听的端口。
KNOT_PORT=8080
# Backend 绑定地址。本机与入口回源都只走本机，保持 127.0.0.1；要让同一内网的机器打开管理后台 /admin，站点把它设为 0.0.0.0。
KNOT_BIND_HOST=127.0.0.1
# 会话 Cookie 名。同一个域名下跑多个站点时要各不相同。
KNOT_SESSION_COOKIE_NAME=knot_sid
# 站点管理员邮箱。必填；用这个邮箱登录后拥有平台管理权限，建议与投诉也寄到这里。
# 例：admin@example.com
KNOT_ADMIN_EMAIL=
# 登录会话有效期（天）。Cookie 和 sessions.expires_at 用同一个值。
KNOT_SESSION_TTL_DAYS=30

# ---- 实例主机 ----
# 本实例的短名。同一台机器上跑多个实例时，只有实例名不同，常驻单元标签（com.knot.<实例>.platform）才互不覆盖。留空取部署根目录名，例如 ~/knot/wang 得到 wang。
# 例：wang
KNOT_INSTANCE=
# local 用本机 Homebrew Postgres；external 用 KNOT_DATABASE_URL，不启动本机库。
KNOT_DB_MODE=local
# KNOT_DB_MODE=external 时的连接串。可能含密码，按密钥对待。
# 例：postgres://knot:密码@db.example.com:5432/knot
KNOT_DATABASE_URL=
# 本机 Postgres 端口。和系统默认的 5432 错开。
KNOT_PGPORT=5433
# 本机 Postgres 数据目录。
KNOT_PGDATA=$HOME/knot/pgdata
# 本机 Postgres 日志文件。
KNOT_PGLOG=$HOME/knot/pg.log
# 本机 Postgres 的 Unix socket 目录。psql -h 传路径时指的是 socket 目录，不是数据目录（数据目录里没有 .s.PGSQL.<端口>）。默认值就是 PostgreSQL 自己的默认 /tmp；只有把库起在别的 socket 目录时才需要改。
KNOT_PG_SOCKET_DIR=/tmp
# PostgreSQL 16 的 bin 目录。Apple Silicon Homebrew 是 /opt/homebrew，Intel 改成 /usr/local/opt/postgresql@16/bin。
KNOT_PG_BIN=/opt/homebrew/opt/postgresql@16/bin
# 上传目录。留空用 <部署根目录>/var/uploads；放在发布包外，升级和回滚都不动它。
KNOT_UPLOAD_DIR=
# 备份目录。留空是还没决定（公网站点会提醒）；写 `null` 表示明确不备份，不再提醒；两者都不装备份任务。填目录后 deploy-site.sh 装每天 04:15 的备份任务（LaunchAgent）。
KNOT_BACKUP_DIR=
# 保留最近几份备份。
KNOT_BACKUP_KEEP=7
# 1 表示备份也收 sites/<站点>/：platform.env（SMTP 密码、管理令牌）、agents/（智能体凭据）。只备份数据库的话，换台机器邮件登录和智能体就都没了。
KNOT_BACKUP_SITES=1
# OpenClaw 状态目录的备份。auto 表示 $HOME/.openclaw 存在就收；1 必须收；0 跳过。只收配置、凭据和 agent 工作区，不含 cache/browser/npm。
KNOT_BACKUP_OPENCLAW=auto
# auto 表示装了 openclaw 才同步；1 必须同步；0 跳过。
KNOT_OPENCLAW=auto

# ---- 从开发机发布 ----
# 实例主机的 ssh 目标，形如 user@host。留空表示目标就是这台机器，直接就地跑 deploy-site.sh。
# 例：deploy@<实例主机>
KNOT_DEPLOY_SSH=
# 实例主机上的部署根目录。sites/、releases/、current、var/ 都在这里，代码在 releases/<版本> 下。和源码仓库分开，按站点命名，例如 ~/knot/wang。
KNOT_DEPLOY_DIR=~/knot/site
# 发布用的私钥。留空用 ssh 默认身份。
KNOT_DEPLOY_SSH_KEY=
# 部署后探活的地址。留空按 http://<实例主机>:<KNOT_PORT>/api/health 推导。
KNOT_DEPLOY_VERIFY_URL=
# 实例主机上保留几个历史发布包。当前版本和回滚目标永远保留，多的按时间清掉。
KNOT_DEPLOY_KEEP=5
# 开发机上构建产物（发布包和校验和）的输出目录。留空用 <knot-platform>/artifacts。
KNOT_ARTIFACT_DIR=

# ---- 公网入口 ----
# 1 表示部署时由这台机器把 WebUI 与 nginx 配置推到 KNOT_ENTRY_SSH；0 表示不碰入口主机（只在本机，或入口已由中枢自动接通）。
KNOT_ENTRY_ENABLED=0
# 入口主机的 ssh 目标。
# 例：ec2-user@<入口主机>
KNOT_ENTRY_SSH=
# 在开发机上推页面用的私钥。
KNOT_ENTRY_SSH_KEY=$HOME/.ssh/id_rsa
# 在实例主机上推公开快照用的私钥，可以和 KNOT_ENTRY_SSH_KEY 不是同一把。
KNOT_ENTRY_PUSH_KEY=$HOME/.ssh/knot-entry-publish
# 入口主机上放 WebUI 的目录。
KNOT_ENTRY_WEB_ROOT=/var/www/knot
# 入口主机上的 nginx 站点配置路径。
KNOT_ENTRY_CONF=/etc/nginx/conf.d/knot.conf
# WebUI 目录的属主。
KNOT_ENTRY_WEB_OWNER=nginx:nginx
# 上传文件的反向代理缓存目录。
KNOT_ENTRY_CACHE_DIR=/var/cache/nginx/knot_uploads
# nginx proxy_cache 区名。
KNOT_ENTRY_CACHE_ZONE=knot_uploads
# 缓存上限，nginx 写法，如 2g。
KNOT_ENTRY_CACHE_SIZE=2g
# 入口主机接受的请求体上限。必须大于后端附件上限，否则大文件在 nginx 就被截断。
KNOT_ENTRY_MAX_BODY=52m
# 入口访问日志。同一台入口主机上的子域共用一个文件，按 $host 分；中枢的流量聚合读它。
KNOT_ENTRY_ACCESS_LOG=/var/log/nginx/knot-access.log
# 入口回源端口。nginx 把 /api 转到这里，隧道再转回实例主机。
KNOT_ENTRY_PROXY_PORT=18080
# 1 监听 443 并配证书；0 只监听 80，证书还没签好时用。
KNOT_ENTRY_SSL=1
# 证书链。留空由 KNOT_DOMAIN 推导。
KNOT_ENTRY_CERT=
# 证书私钥。留空由 KNOT_DOMAIN 推导。
KNOT_ENTRY_KEY=
# 改完 nginx 配置后的 reload 命令。入口主机不是 systemd（例如 OpenBSD、launchd）时改成自己的。
KNOT_ENTRY_RELOAD_CMD="sudo systemctl reload nginx"

# ---- 回源隧道 ----
# 1 表示实例主机主动连出建隧道，让 xknot.si 子域入口能回源。没有入口时留 0；本机也接了子域时由 sites/<站点>/tunnel.env 写 1。
KNOT_TUNNEL=0
# 隧道账号。留空是 knot-tunnel@<KNOT_ENTRY_SSH 的主机>。
KNOT_TUNNEL_SSH=
# 实例主机上建隧道用的私钥。相对路径按站点目录（sites/<站点>/）解析；自动接通写的 tunnel.env 用 tunnel_ed25519。
KNOT_TUNNEL_KEY=$HOME/.ssh/knot-entry
# 隧道落回本机的端口。留空等于 KNOT_PORT。
KNOT_TUNNEL_LOCAL_PORT=
# 隧道在入口主机上占用的端口。留空等于 KNOT_ENTRY_PROXY_PORT。
KNOT_TUNNEL_REMOTE_PORT=

