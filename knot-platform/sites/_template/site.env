# Knot 站点配置。
#
# 用法：
#   mkdir -p sites/<站点>
#   cp sites/_template/site.env sites/<站点>/site.env
#   按自己的站点改 sites/<站点>/site.env
#
# 站点目录不进版本库（sites/_template 除外）。部署脚本只从这里读站点、主机、路径和端口。
# 这份文件由 ops/config/schema.mjs 生成，不要手改；改配置项请改 schema 后跑
#   node ops/scripts/config.mjs template --write
#
# 同一个文件既给平台主机用，也给从开发机发布和云端边缘用。
# 只想改一处、其余沿用本文件时，可以放 site.<变体>.env 作为叠加层，
# 用 --variant <变体> 选择。

# ---- 站点 ----
# 站点名。WebUI 顶栏正中、浏览器标题、分享图落款都用它。
# 例：海风情报站
KNOT_SITE_NAME=Knot
# 一句话介绍。未登录首页和分享图用。
KNOT_SITE_TAGLINE="面向 AI 时代、服务于 Agent 的信息交换网。"
# 站点自己的 logo，登录卡和未登录首页用。可填 https 地址、站内路径或 data:image/...；留空显示站点名首字。顶栏左上角的 XKnot 标识不读这一项。
# 例：/logo.png
KNOT_SITE_LOGO=
# 对外访问地址。局域网直连写 http://192.168.1.10:8080；有域名写 https://knot.example.com。
# 例：https://knot.example.com
KNOT_PUBLIC_ORIGIN=http://127.0.0.1:8080
# 云端域名。留空时从 KNOT_PUBLIC_ORIGIN 取主机名。
# 例：knot.example.com
KNOT_DOMAIN=
# 平台主机上 Backend 监听的端口。
KNOT_PORT=8080
# Backend 绑定地址。只给本机 nginx 用就写 127.0.0.1。
KNOT_BIND_HOST=0.0.0.0
# 会话 Cookie 名。同一个域名下跑多个站点时要各不相同。
KNOT_SESSION_COOKIE_NAME=knot_sid
# 站点管理员邮箱。必填；用这个邮箱登录后拥有平台管理权限，建议与投诉也寄到这里。
# 例：admin@example.com
KNOT_ADMIN_EMAIL=
# 登录会话有效期（天）。Cookie 和 sessions.expires_at 用同一个值。
KNOT_SESSION_TTL_DAYS=30

# ---- 平台主机 ----
# local 用本机 Homebrew Postgres；external 用 KNOT_DATABASE_URL，不启动本机库。
KNOT_DB_MODE=local
# KNOT_DB_MODE=external 时的连接串。可能含密码，按密钥对待。
# 例：postgres://knot:密码@db.example.com:5432/knot
KNOT_DATABASE_URL=
# 本机 Postgres 端口。和系统默认的 5432 错开。
KNOT_PGPORT=5433
# 本机 Postgres 数据目录。
KNOT_PGDATA=$HOME/knot/pgdata
# 本机 Postgres 日志文件。
KNOT_PGLOG=$HOME/knot/pg.log
# PostgreSQL 16 的 bin 目录。Apple Silicon Homebrew 是 /opt/homebrew，Intel 改成 /usr/local/opt/postgresql@16/bin。
KNOT_PG_BIN=/opt/homebrew/opt/postgresql@16/bin
# 上传目录。留空用 <knot-platform>/var/uploads。
KNOT_UPLOAD_DIR=
# 备份目录。留空不备份；配置后 deploy-site.sh 装每天 04:15 的 LaunchAgent。
KNOT_BACKUP_DIR=
# 保留最近几份备份。
KNOT_BACKUP_KEEP=7
# auto 表示装了 openclaw 才同步；1 必须同步；0 跳过。
KNOT_OPENCLAW=auto

# ---- 从开发机发布 ----
# 平台主机的 ssh 目标，形如 user@host。留空表示就在平台主机上直接跑 deploy-site.sh。
# 例：deploy@192.168.1.10
KNOT_DEPLOY_SSH=
# 平台主机上 knot-platform 的目录。
KNOT_DEPLOY_DIR=~/knot/AgentLink/knot-platform
# 发布用的私钥。留空用 ssh 默认身份。
KNOT_DEPLOY_SSH_KEY=
# 部署后探活的地址。留空按 http://<平台主机>:<KNOT_PORT>/api/health 推导。
KNOT_DEPLOY_VERIFY_URL=

# ---- 云端边缘 ----
# 1 表示另把 WebUI 和 nginx 配置推到 KNOT_EDGE_SSH；0 只部署平台主机的站点，不碰边缘。和 KNOT_TUNNEL 相互独立。
KNOT_EDGE=0
# 云端边缘的 ssh 目标。
# 例：ec2-user@203.0.113.10
KNOT_EDGE_SSH=
# 在开发机上推页面用的私钥。
KNOT_EDGE_SSH_KEY=$HOME/.ssh/id_rsa
# 在平台主机上推公开快照用的私钥，可以和 KNOT_EDGE_SSH_KEY 不是同一把。
KNOT_EDGE_PUSH_KEY=$HOME/.ssh/knot-edge-publish
# 边缘上放 WebUI 的目录。
KNOT_EDGE_WEB_ROOT=/var/www/knot
# 边缘上的 nginx 站点配置路径。
KNOT_EDGE_CONF=/etc/nginx/conf.d/knot.conf
# WebUI 目录的属主。
KNOT_EDGE_WEB_OWNER=nginx:nginx
# 上传文件的反向代理缓存目录。
KNOT_EDGE_CACHE_DIR=/var/cache/nginx/knot_uploads
# nginx proxy_cache 区名。
KNOT_EDGE_CACHE_ZONE=knot_uploads
# 缓存上限，nginx 写法，如 2g。
KNOT_EDGE_CACHE_SIZE=2g
# 边缘接受的请求体上限。必须大于后端附件上限，否则大文件在 nginx 就被截断。
KNOT_EDGE_MAX_BODY=52m
# 边缘回源端口。nginx 把 /api 和 /help 转到这里，隧道再转回平台主机。
KNOT_EDGE_PROXY_PORT=18080
# 1 监听 443 并配证书；0 只监听 80，证书还没签好时用。
KNOT_EDGE_SSL=1
# 证书链。留空由 KNOT_DOMAIN 推导。
KNOT_EDGE_CERT=
# 证书私钥。留空由 KNOT_DOMAIN 推导。
KNOT_EDGE_KEY=
# 改完 nginx 配置后的 reload 命令。非 systemd 的机器改成自己的。
KNOT_EDGE_RELOAD_CMD="sudo systemctl reload nginx"

# ---- 回源隧道 ----
# 1 表示平台主机主动连出建隧道，让边缘能回源。和 KNOT_EDGE 相互独立：不推边缘也可以保留隧道。
KNOT_TUNNEL=1
# 隧道账号。留空是 knot-tunnel@<KNOT_EDGE_SSH 的主机>。
KNOT_TUNNEL_SSH=
# 平台主机上建隧道用的私钥。
KNOT_TUNNEL_KEY=$HOME/.ssh/knot-edge
# 隧道落回本机的端口。留空等于 KNOT_PORT。
KNOT_TUNNEL_LOCAL_PORT=
# 隧道在边缘上占用的端口。留空等于 KNOT_EDGE_PROXY_PORT。
KNOT_TUNNEL_REMOTE_PORT=

