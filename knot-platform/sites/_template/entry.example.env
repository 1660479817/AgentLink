# 一个 xknot.si 子域入口。由 packages/knot-config/src/schema.mjs 生成，不要手改。
#
# 复制成 sites/<站点>/entry.<标签>.xknot.si.env，再把 <标签>.xknot.si 换成下面的 KNOT_DOMAIN。
#
# 官方只支持一个入口，域名必须是 xknot.si 签发的二级子域（<标签>.xknot.si）。
# 它是叠加层：site.env 里的键在这里都能覆盖，没写的沿用 site.env。
#
# 只写「这个入口和站点默认值不一样」的项。KNOT_ENTRY_WEB_ROOT 与 KNOT_ENTRY_CONF
# 必须按这个子域写清，留空等于和别的子域共用同一个静态根与 nginx 配置；
# config.mjs check 会拦住缺失或写错的域名。
#
# 改配置项请改 schema 后跑 node ops/scripts/config.mjs entry-template --write。

# xknot.si 签发的二级子域，形如 <标签>.xknot.si。只在本机访问时留空；接子域时与入口文件名一致。
# 例：wang.xknot.si
KNOT_DOMAIN=

# 入口主机上放 WebUI 的目录。
KNOT_ENTRY_WEB_ROOT=

# 入口主机上的 nginx 站点配置路径。
KNOT_ENTRY_CONF=

# 证书链。留空由 KNOT_DOMAIN 推导。
KNOT_ENTRY_CERT=

# 证书私钥。留空由 KNOT_DOMAIN 推导。
KNOT_ENTRY_KEY=

# static：首页与 /assets 从入口主机上的磁盘出，只有动态走隧道；proxy：连首页也回源到实例。
KNOT_ENTRY_SERVE=static

