# One xknot.si subdomain entry. Generated by packages/knot-config/src/schema.mjs; do not hand-edit.
#
# Copy to sites/<site>/entry.<label>.xknot.si.env, then replace <label>.xknot.si with the KNOT_DOMAIN below.
#
# Officially only one entry is supported, and the domain must be an xknot.si-issued sub-subdomain (<label>.xknot.si).
# It is an overlay: every key in site.env can be overridden here; anything not written falls back to site.env.
#
# Only write the items where this entry differs from the site defaults. KNOT_ENTRY_WEB_ROOT and KNOT_ENTRY_CONF
# must be written per this subdomain; leaving them empty shares one static root and nginx config with other subdomains;
# config.mjs check blocks a missing or wrong domain.
#
# To change a config item, change the schema then run node ops/scripts/config.mjs entry-template --write.

# The sub-subdomain issued by xknot.si, shaped <label>.xknot.si. Leave empty for local-only access; when taking a subdomain, match the entry filename.
# Example: wang.xknot.si
KNOT_DOMAIN=

# The directory holding the WebUI on the entry host. Must be written per subdomain: empty falls back to the shared /var/www/knot and overwrites other subdomains on the same machine.
KNOT_ENTRY_WEB_ROOT="/var/www/<label>"

# The nginx site config path on the entry host. Must be written per subdomain: empty falls back to the shared /etc/nginx/conf.d/knot.conf.
KNOT_ENTRY_CONF="/etc/nginx/conf.d/<label>.xknot.si.conf"

# The certificate chain. Empty derives from KNOT_DOMAIN.
KNOT_ENTRY_CERT=

# The certificate private key. Empty derives from KNOT_DOMAIN.
KNOT_ENTRY_KEY=

# static: the home page and /assets are served from disk on the entry host, only dynamic requests go through the tunnel; proxy: even the home page back-origins to the instance.
KNOT_ENTRY_SERVE=static

