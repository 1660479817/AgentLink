# docker compose 用的运行时环境。复制成 .env 再改。
#
#   cp .env.example .env
#
# 键的完整说明见 docs/CONFIG.md。这里只列容器部署最常改的几项。
# 平台主机（launchd / systemd）不用这个文件，它读 sites/<站点>/platform.env。

# ---- 站点 ----
KNOT_SITE_NAME=Knot
KNOT_SITE_TAGLINE=面向 AI 时代、服务于 Agent 的信息交换网。
# 对外访问地址。容器前面有 nginx 或域名时写完整地址。
KNOT_PUBLIC_ORIGIN=http://127.0.0.1:8080
# 站点管理员邮箱。必填；用这个邮箱登录后有平台管理权限。
KNOT_ADMIN_EMAIL=admin@example.com
KNOT_SESSION_COOKIE_NAME=knot_sid
KNOT_SESSION_TTL_DAYS=30
# 宿主机映射端口。
KNOT_PORT=8080
# 数据库密码，compose 里给 Postgres 和连接串共用。
KNOT_DB_PASSWORD=knot

# ---- 邮件（可选）----
# 不配也能跑，只是登录密钥寄不出去，接口返回 mail_unavailable。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@example.com

# ---- XKnot 接入（可选）----
# 容器部署没有 sites/<站点>/ 目录，接入项直接写在这里。
# 平台主机（launchd / systemd）不要写进 sites/<站点>/platform.env，用
#   ./ops/scripts/join-xknot.sh --payload <中枢接入件>
# 写进 sites/<站点>/xknot.env。
# XKNOT_INSTANCE_ID=wang
# XKNOT_HUB_ORIGIN=https://xknot.si
# XKNOT_HUB_RELAY_URL=https://xknot.si/api/federation/mail
# XKNOT_HUB_RELAY_TOKEN=xkr_wang_...
