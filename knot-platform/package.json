{
  "name": "knot-platform-workspace",
  "version": "0.9.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.20.0",
  "type": "module",
  "workspaces": [
    "backend",
    "web",
    "packages/*"
  ],
  "scripts": {
    "test": "node ops/scripts/run-tests.mjs",
    "config": "node ops/scripts/config.mjs",
    "build": "./ops/scripts/build.sh",
    "build:web": "npm run build -w web && node web/scripts/build-discover.mjs && node web/scripts/check-legacy.mjs",
    "deploy": "./ops/scripts/deploy-site.sh",
    "deploy:local": "./ops/scripts/push-deploy.sh --site local",
    "push": "./ops/scripts/push-deploy.sh",
    "rollback": "./ops/scripts/rollback.sh",
    "migrate": "node backend/scripts/migrate.js",
    "dev:platform": "npm run dev -w knot-platform",
    "dev:web": "npm run dev -w web"
  }
}
