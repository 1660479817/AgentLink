<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.knot.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__KNOT_HOME__/ops/scripts/backup-knot.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__KNOT_HOME__</string>
  <key>RunAtLoad</key>
  <false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__KNOT_HOME__/var/log/knot-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__KNOT_HOME__/var/log/knot-backup.err.log</string>
</dict>
</plist>
