<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.knot.platform</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KNOT_SITE</key>
    <string>__KNOT_SITE__</string>
    <key>KNOT_DEPLOY_ROOT</key>
    <string>__KNOT_HOME__</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>__KNOT_CURRENT__/ops/scripts/run-knot-platform.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__KNOT_HOME__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__KNOT_HOME__/var/log/knot-platform.log</string>
  <key>StandardErrorPath</key>
  <string>__KNOT_HOME__/var/log/knot-platform.err.log</string>
</dict>
</plist>
