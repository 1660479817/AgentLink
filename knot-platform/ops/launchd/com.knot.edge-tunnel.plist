<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.knot.edge-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__KNOT_HOME__/ops/scripts/run-edge-tunnel.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__KNOT_HOME__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__KNOT_HOME__/var/log/edge-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>__KNOT_HOME__/var/log/edge-tunnel.err.log</string>
</dict>
</plist>
