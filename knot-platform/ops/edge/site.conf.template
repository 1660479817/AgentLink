# Knot 云端边缘。由 ops/scripts/render-config.mjs 从 ops/deploy.env 生成。
# 不要在这种模板里写死域名、目录或端口；改 ops/deploy.env。
#
# 边缘只做三件事：
#   1. 提供 WebUI 静态文件；
#   2. 把 /api、/help 反代到回源端口（隧道或同机 Backend）；
#   3. 给 /discover.json 和 /api/web/uploads/ 加缓存。

proxy_cache_path {{KNOT_EDGE_CACHE_DIR}} levels=1:2 keys_zone={{KNOT_EDGE_CACHE_ZONE}}:10m max_size={{KNOT_EDGE_CACHE_SIZE}} inactive=7d use_temp_path=off;

server {
    server_name {{KNOT_DOMAIN}};

    client_max_body_size {{KNOT_EDGE_MAX_BODY}};

    location /.well-known/acme-challenge/ {
        root {{KNOT_EDGE_WEB_ROOT}};
    }

    # 隧道回到平台主机时，管理接口不能跟着公开。
    location ^~ /api/admin {
        default_type application/json;
        return 404 '{"error":"not_found"}';
    }

    # 上传文件（信息流图片 /display、头像、赞助图）：边缘缓存，避免每张图都穿隧道回平台。
    #
    # 缓存键只有 $uri，不含会话，所以「能不能进共享缓存」完全交给后端的 Cache-Control：
    #   - 头像、赞助图、未登录也能读的公开内容 → public，进缓存；
    #   - 只有当事人能读的内容（自己的私帖、wish 的回复）→ private，nginx 不缓存；
    #   - 生成失败回退原件 → no-store，不缓存。
    # 下架不会让缓存立刻失效：条目到期前仍按旧响应分发，所以 max-age 设为 1 天而不是 7 天。
    location ^~ /api/web/uploads/ {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_cache {{KNOT_EDGE_CACHE_ZONE}};
        proxy_cache_key "$uri";
        proxy_cache_valid 200 1d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Knot-Cache $upstream_cache_status;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /help {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_read_timeout 30s;
    }

    location = /index.html {
        root {{KNOT_EDGE_WEB_ROOT}};
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /assets/ {
        root {{KNOT_EDGE_WEB_ROOT}};
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # 发现页的公开快照。文件由平台推上来；还没有文件时回到回源端口。
    location = /discover.json {
        root {{KNOT_EDGE_WEB_ROOT}};
        try_files /discover.json @knot_origin;
        add_header Cache-Control "public, max-age=0, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /media/previews/ {
        root {{KNOT_EDGE_WEB_ROOT}};
        try_files $uri @knot_origin;
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location @knot_origin {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_read_timeout 30s;
    }

    # 静态文件与 SPA 兜底。反代位置不写这两个头，交给 Backend，免得同一个值出现两行。
    location / {
        root {{KNOT_EDGE_WEB_ROOT}};
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

{{#KNOT_EDGE_SSL}}
    listen 443 ssl;
    ssl_certificate {{KNOT_EDGE_CERT}};
    ssl_certificate_key {{KNOT_EDGE_KEY}};
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
{{/KNOT_EDGE_SSL}}
{{^KNOT_EDGE_SSL}}
    listen 80;
{{/KNOT_EDGE_SSL}}
}

{{#KNOT_EDGE_SSL}}
server {
    listen 80;
    server_name {{KNOT_DOMAIN}};

    location /.well-known/acme-challenge/ {
        root {{KNOT_EDGE_WEB_ROOT}};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
{{/KNOT_EDGE_SSL}}