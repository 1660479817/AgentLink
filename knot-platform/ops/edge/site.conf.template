# Knot 云端边缘。由 ops/scripts/render-config.mjs 从 sites/<站点>/site.env
# 叠加 sites/<站点>/edge.<域名>.env 生成。
# 不要在这两份模板里写死域名、目录或端口；改站点配置。
#
# 一份配置服务一个公网入口（KNOT_DOMAIN）。同一实例的其它入口各有一份。
# 边缘只做三件事：
#   1. 提供 WebUI 静态文件（KNOT_ENTRY_SERVE=static），或整站回源（=proxy）；
#   2. 把 /api、/help 反代到回源端口（隧道或同机 Backend）；
#   3. 给 /discover.json 和 /api/web/uploads/ 加缓存（仅 static 投放）。
#
# 缓存区（proxy_cache_path）不在这里声明：整台边缘只允许一次，放在 cache.conf.template，
# 由 push-edge.sh 单独装成 knot-cache.conf。多个入口共用同一个 zone。

server {
    server_name {{KNOT_DOMAIN}};

    client_max_body_size {{KNOT_EDGE_MAX_BODY}};

    location /.well-known/acme-challenge/ {
        root {{KNOT_EDGE_WEB_ROOT}};
    }

    # 隧道回到平台主机时，管理接口和管理后台都不能跟着公开。
    location ^~ /api/admin {
        default_type application/json;
        return 404 '{"error":"not_found"}';
    }

    location ^~ /admin {
        default_type application/json;
        return 404 '{"error":"not_found"}';
    }

{{#KNOT_ENTRY_STATIC}}
    # 上传文件（信息流图片 /display、头像、赞助图）：边缘缓存，避免每张图都穿隧道回平台。
    #
    # 缓存键只有 $uri，不含会话，所以「能不能进共享缓存」完全交给后端的 Cache-Control：
    #   - 头像、赞助图、未登录也能读的公开内容 → public，进缓存；
    #   - 只有当事人能读的内容（自己的私帖、wish 的回复）→ private，nginx 不缓存；
    #   - 生成失败回退原件 → no-store，不缓存。
    # 下架不会让缓存立刻失效：条目到期前仍按旧响应分发，所以 max-age 设为 1 天而不是 7 天。
    location ^~ /api/web/uploads/ {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_cache {{KNOT_EDGE_CACHE_ZONE}};
        proxy_cache_key "$uri";
        proxy_cache_valid 200 1d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Knot-Cache $upstream_cache_status;
    }
{{/KNOT_ENTRY_STATIC}}
{{^KNOT_ENTRY_STATIC}}
    # proxy 投放不在这里另开缓存区：同一台 nginx 上同名 zone 不能声明两次，
    # 而上传文件本来就该由持有数据的实例回，缓存留给 static 入口去做。
    location ^~ /api/web/uploads/ {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
{{/KNOT_ENTRY_STATIC}}

    location /api/ {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /help {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_read_timeout 30s;
    }

{{#KNOT_ENTRY_STATIC}}
    location = /index.html {
        root {{KNOT_EDGE_WEB_ROOT}};
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /assets/ {
        root {{KNOT_EDGE_WEB_ROOT}};
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # 发现页的公开快照。文件由平台推上来；还没有文件时回到回源端口。
    location = /discover.json {
        root {{KNOT_EDGE_WEB_ROOT}};
        try_files /discover.json @knot_origin;
        add_header Cache-Control "public, max-age=0, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /media/previews/ {
        root {{KNOT_EDGE_WEB_ROOT}};
        try_files $uri @knot_origin;
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location @knot_origin {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_read_timeout 30s;
    }

    # 静态文件与 SPA 兜底。反代位置不写这两个头，交给 Backend，免得同一个值出现两行。
    location / {
        root {{KNOT_EDGE_WEB_ROOT}};
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
{{/KNOT_ENTRY_STATIC}}
{{^KNOT_ENTRY_STATIC}}
    # proxy 投放：/、/assets/、SPA 兜底、/discover.json、/media/previews/ 全部回源。
    # 好处是页面与接口永远来自同一次构建，代价是每个静态文件都要穿一次隧道。
    # 安全头交给 Backend：这里再加一遍，同一个响应会出现两行同名头。
    location / {
        proxy_pass http://127.0.0.1:{{KNOT_EDGE_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_EDGE_SSL}}https{{/KNOT_EDGE_SSL}}{{^KNOT_EDGE_SSL}}$scheme{{/KNOT_EDGE_SSL}};
        proxy_read_timeout 30s;
    }
{{/KNOT_ENTRY_STATIC}}

{{#KNOT_EDGE_SSL}}
    listen 443 ssl;
    ssl_certificate {{KNOT_EDGE_CERT}};
    ssl_certificate_key {{KNOT_EDGE_KEY}};
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
{{/KNOT_EDGE_SSL}}
{{^KNOT_EDGE_SSL}}
    listen 80;
{{/KNOT_EDGE_SSL}}
}

{{#KNOT_EDGE_SSL}}
server {
    listen 80;
    server_name {{KNOT_DOMAIN}};

    location /.well-known/acme-challenge/ {
        root {{KNOT_EDGE_WEB_ROOT}};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
{{/KNOT_EDGE_SSL}}
