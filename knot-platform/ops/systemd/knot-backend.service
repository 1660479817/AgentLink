[Unit]
Description=Knot Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__KNOT_USER__
Group=__KNOT_USER__
EnvironmentFile=__KNOT_ENV_FILE__
# 接入配置可以不存在；前面的减号表示文件缺失时跳过而不是启动失败。
EnvironmentFile=-__KNOT_XKNOT_ENV__
WorkingDirectory=__KNOT_CURRENT__
ExecStart=/usr/bin/env node backend/src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__KNOT_HOME__/var

[Install]
WantedBy=multi-user.target
