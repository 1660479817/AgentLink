[Unit]
Description=Knot Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__KNOT_USER__
Group=__KNOT_USER__
EnvironmentFile=__KNOT_ENV_FILE__
# 接入配置可以不存在；前面的减号表示文件缺失时跳过而不是启动失败。
EnvironmentFile=-__KNOT_XKNOT_ENV__
WorkingDirectory=__KNOT_CURRENT__
ExecStart=/usr/bin/env node backend/src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# UPLOAD_DIR 是普通路径键，可以配到 var/ 之外；只放开 var/ 时后端在
# ProtectSystem=full 下写不了上传目录，上传会直接失败。两个都列上（重复无害），
# 前缀 - 表示这一项不存在时不要因此起不来。
ReadWritePaths=__KNOT_HOME__/var
ReadWritePaths=-__KNOT_UPLOAD_DIR__
# 后端写出来的文件（上传原件、转写）默认不该对同机其他用户可读。
UMask=0077

[Install]
WantedBy=multi-user.target
