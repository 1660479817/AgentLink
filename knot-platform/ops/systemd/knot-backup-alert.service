[Unit]
Description=Knot 备份失败提示
# 由 knot-backup.service 的 OnFailure= 触发。目标不是真发通知，而是把失败
# 从「一个 active 到天荒地老的 unit」变成一条明确记进 syslog/journal 的错误，
# 巡检、systemctl --failed 与日志采集都看得到。
After=knot-backup.service

[Service]
Type=oneshot
ExecStart=/usr/bin/logger -t knot-backup -p user.err "Knot 每日备份失败：用 journalctl -u knot-backup.service 看原因，修好后 systemctl start knot-backup.service 补一次。"
