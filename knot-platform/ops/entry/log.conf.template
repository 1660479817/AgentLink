# Knot 入口的访问日志格式。
#
# 单独一份，和 cache.conf.template 同一个道理：log_format 只能声明一次，
# 而每个子域是一份 server conf。写进 site.conf.template 的话，装第二个子域时
# nginx 会报「duplicate log format name」，整份配置都过不了 nginx -t。
#
# 由 push-entry.sh 装在规范入口的 conf 同目录下，文件名 knot-log.conf。
# site.conf.template 里的 access_log 按这个名字引用。

# 子域靠 $host 区分，聚合端再映射到 instances.json 里的 id。
#
# 只记 $uri，不记 $args：查询串里可能带分享令牌与搜索词，流量统计不需要它们，
# 写进日志就等于多存了一份凭据。referer 只落原文，聚合时只取主机名。
#
# escape=json 处理 UA 里的引号；$request_time 是秒，聚合时换算成毫秒。
# $upstream_response_time 可能是 "-"、单个数值或 "0.1, 0.2"（多次回源），
# 一律按字符串记，由聚合端取第一个数。
log_format knot_json escape=json
  '{"at":"$time_iso8601","host":"$host","status":$status,"method":"$request_method",'
  '"uri":"$uri","bytes":$body_bytes_sent,"requestTime":$request_time,'
  '"upstreamTime":"$upstream_response_time","cache":"$upstream_cache_status",'
  '"ip":"$remote_addr","ua":"$http_user_agent","ref":"$http_referer"}';
