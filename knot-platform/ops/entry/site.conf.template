# Knot 公网入口。由 ops/scripts/render-config.mjs 从 sites/<站点>/site.env
# 叠加 sites/<站点>/entry.<域名>.env 生成。
# 不要在这两份模板里写死域名、目录或端口；改站点配置。
#
# 一份配置服务一个 xknot.si 子域入口（KNOT_DOMAIN）。
# 入口只做三件事：
#   1. 提供 WebUI 静态文件（KNOT_ENTRY_SERVE=static），或整站回源（=proxy）；
#   2. 把 /api 反代到回源端口（隧道或同机 Backend）；
#   3. 给 /discover.json 和 /api/web/uploads 加缓存（仅 static 投放）。
# 入口不发文档：Agent 指引在 xknot.si/knot-help，实例没有 /help 页，
# 它和任何不存在的路径一样落到 SPA 兜底，入口不为它单独回源。
#
# 缓存区（proxy_cache_path）不在这里声明：同一台入口主机只允许一次，放在 cache.conf.template，
# 由 push-entry.sh 单独装成 knot-cache.conf。
#
# 真实客户端地址（real_ip）同理：同一台入口主机上所有子域面对的是同一组
# Cloudflare 网段，写在 realip.conf，由 push-entry.sh 装成 knot-realip.conf。
# 每个子域各写一份 set_real_ip_from，后装的那份会把前一份盖掉。

# 回源统一走这个 upstream，才能复用连接。
#
# 名字带端口：同一台入口主机上可能挂多个子域，每个子域有自己的回源端口。
# 走 SSH 反向隧道时，每新建一条 TCP 都要多一次跨洋往返（开 channel + 连后端），
# 复用长连接后一个 /api 请求少一个 RTT。keepalive_timeout 压在 Backend 的
# keepAliveTimeout（Node 默认 5s）之下，避免正好撞上后端关空闲连接的瞬间。
upstream knot_entry_{{KNOT_ENTRY_PROXY_PORT}} {
    server 127.0.0.1:{{KNOT_ENTRY_PROXY_PORT}};
    keepalive 16;
    keepalive_timeout 4s;
}

server {
    server_name {{KNOT_DOMAIN}};

    client_max_body_size {{KNOT_ENTRY_MAX_BODY}};

    # 每个子域一行访问日志，格式在 knot-log.conf（同一台入口主机只装一次）。
    # 同一份文件按 $host 区分，聚合见 xknot.si/ops/traffic.mjs。
    access_log {{KNOT_ENTRY_ACCESS_LOG}} knot_json;

    # 入口这一层没有 http 级的 gzip（同一台机上别的 vhost 各写各的，不共享），
    # 不在这里开，JS/CSS/JSON 就按原文发出去：主包 263KB，压完约 84KB。
    # gzip_proxied any 让穿过隧道的 /api 响应也压（JSON 收益最大）。
    # gzip_types 里不放图片/字体：jpeg、png、woff2 本来就压过了。
    # 这里不放 text/markdown：入口只出 WebUI 与快照，不发文档（Agent 指引在中枢
    # xknot.si/knot-help）。xml 给 sitemap。
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml;

    location /.well-known/acme-challenge/ {
        root {{KNOT_ENTRY_WEB_ROOT}};
    }

    # 隧道回到实例主机时，管理接口和管理后台都不能跟着公开。
    location ^~ /api/admin {
        default_type application/json;
        return 404 '{"error":"not_found"}';
    }

    location ^~ /admin {
        default_type application/json;
        return 404 '{"error":"not_found"}';
    }

{{#KNOT_ENTRY_STATIC}}
    # 上传文件（信息流图片 /display、头像、赞助图）：入口缓存，避免每张图都穿隧道回平台。
    #
    # 缓存键只有 $uri，不含会话，所以「能不能进共享缓存」完全交给后端的 Cache-Control：
    #   - 头像、赞助图、未登录也能读的公开内容 → public，进缓存；
    #   - 只有当事人能读的内容（自己的私帖、买到的商品）→ private，nginx 不缓存；
    #   - 生成失败回退原件 → no-store，不缓存。
    # 下架不会让缓存立刻失效：条目到期前仍按旧响应分发，所以 max-age 设为 1 天而不是 7 天。
    #
    # location 不带尾斜杠：带上之后 nginx 会把 /api/web/uploads 当成目录，
    # 对 POST 回 301 补斜杠；浏览器跟随时按 GET 重发、请求体丢掉，WebUI 传图就 404。
    location ^~ /api/web/uploads {
        proxy_pass http://knot_entry_{{KNOT_ENTRY_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_ENTRY_SSL}}https{{/KNOT_ENTRY_SSL}}{{^KNOT_ENTRY_SSL}}$scheme{{/KNOT_ENTRY_SSL}};
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_cache {{KNOT_ENTRY_CACHE_ZONE}};
        proxy_cache_key "$uri";
        proxy_cache_valid 200 1d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Knot-Cache $upstream_cache_status;
    }
{{/KNOT_ENTRY_STATIC}}
{{^KNOT_ENTRY_STATIC}}
    # proxy 投放不在这里另开缓存区：同一台 nginx 上同名 zone 不能声明两次，
    # 而上传文件本来就该由持有数据的实例回，缓存留给 static 入口去做。
    # 同样不带尾斜杠，否则 POST /api/web/uploads 会被 301 补斜杠、传图失败。
    location ^~ /api/web/uploads {
        proxy_pass http://knot_entry_{{KNOT_ENTRY_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_ENTRY_SSL}}https{{/KNOT_ENTRY_SSL}}{{^KNOT_ENTRY_SSL}}$scheme{{/KNOT_ENTRY_SSL}};
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
{{/KNOT_ENTRY_STATIC}}

{{#KNOT_ENTRY_STATIC}}
    # 匿名公开读的入口短缓存。
    #
    # 这条链路是「读者 → 入口 → 跨洋隧道 → 实例」。静态快照已经绕开隧道，但首屏的
    # 会话、公开信息流、卡片详情仍要走一次往返（约 300ms）。这些响应在未登录时对
    # 所有人相同，入口缓存几秒就能让第一个和第一百个读者都只等一个 RTT。
    #
    # 只缓存 GET，且只要请求带任何 Cookie 就整条绕过（proxy_cache_bypass / proxy_no_cache）：
    # 登录后的 starred/liked/mine 与未读数逐人不同，不能进共享缓存。
    # 检索不在这里：它会写 search_events，也按人限流，必须逐次回源。
    location ~ "^/api/web/(session|home|information|facets|people|sponsors|economy|intel/[0-9a-fA-F-]{36})$" {
        proxy_pass http://knot_entry_{{KNOT_ENTRY_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_ENTRY_SSL}}https{{/KNOT_ENTRY_SSL}}{{^KNOT_ENTRY_SSL}}$scheme{{/KNOT_ENTRY_SSL}};
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_cache {{KNOT_ENTRY_CACHE_ZONE}};
        proxy_cache_key "api:$scheme$host$request_uri";
        proxy_cache_bypass $http_cookie;
        proxy_no_cache $http_cookie;
        proxy_cache_valid 200 10s;
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Knot-Cache $upstream_cache_status;
    }
{{/KNOT_ENTRY_STATIC}}

    location /api/ {
        proxy_pass http://knot_entry_{{KNOT_ENTRY_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_ENTRY_SSL}}https{{/KNOT_ENTRY_SSL}}{{^KNOT_ENTRY_SSL}}$scheme{{/KNOT_ENTRY_SSL}};
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 入口不认 /help：Agent 指引是协议层文档，在 xknot.si/knot-help。实例没有这个页面，
    # 它和任何不存在的路径一样走下面的 SPA 兜底。

{{#KNOT_ENTRY_STATIC}}
    location = /index.html {
        root {{KNOT_ENTRY_WEB_ROOT}};
        # no-store 而不是 no-cache：微信内置浏览器会跳过校验直接复用旧 HTML。
        # 旧 HTML 指向的 /assets/<hash> 在发布后已经被删掉，页面就只剩白屏。
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /assets/ {
        root {{KNOT_ENTRY_WEB_ROOT}};
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # 发现页的公开快照。文件由平台推上来；还没有文件时回到回源端口。
    #
    # 允许浏览器用 30 秒内的那一份：首屏本来就要等它，回源校验一次就是一次跨境往返。
    # 内容变化由 Backend 主动推送，读者最多晚 30 秒看到新帖，换来的是打开即画。
    # 过期后仍先给旧的、后台再校验，缓存过期的那一下也不会白屏。
    location = /discover.json {
        root {{KNOT_ENTRY_WEB_ROOT}};
        try_files /discover.json @knot_origin;
        add_header Cache-Control "public, max-age=30, stale-while-revalidate=300";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location @knot_origin {
        proxy_pass http://knot_entry_{{KNOT_ENTRY_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_ENTRY_SSL}}https{{/KNOT_ENTRY_SSL}}{{^KNOT_ENTRY_SSL}}$scheme{{/KNOT_ENTRY_SSL}};
        proxy_read_timeout 30s;
    }

    # 静态文件与 SPA 兜底。反代位置不写这两个头，交给 Backend，免得同一个值出现两行。
    location / {
        root {{KNOT_ENTRY_WEB_ROOT}};
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
{{/KNOT_ENTRY_STATIC}}
{{^KNOT_ENTRY_STATIC}}
    # proxy 投放：/、/assets/、SPA 兜底、/discover.json 全部回源。
    # 好处是页面与接口永远来自同一次构建，代价是每个静态文件都要穿一次隧道。
    # 安全头交给 Backend：这里再加一遍，同一个响应会出现两行同名头。
    location / {
        proxy_pass http://knot_entry_{{KNOT_ENTRY_PROXY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{#KNOT_ENTRY_SSL}}https{{/KNOT_ENTRY_SSL}}{{^KNOT_ENTRY_SSL}}$scheme{{/KNOT_ENTRY_SSL}};
        proxy_read_timeout 30s;
    }
{{/KNOT_ENTRY_STATIC}}

{{#KNOT_ENTRY_SSL}}
    # 一个页面要连 4～6 个文件，HTTP/1.1 得各开一条连接、各做一次握手；
    # 入口到读者动辄百毫秒 RTT，这一项比压不压缩更值钱。
    listen 443 ssl;
    http2 on;
    ssl_certificate {{KNOT_ENTRY_CERT}};
    ssl_certificate_key {{KNOT_ENTRY_KEY}};
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
{{/KNOT_ENTRY_SSL}}
{{^KNOT_ENTRY_SSL}}
    listen 80;
{{/KNOT_ENTRY_SSL}}
}

{{#KNOT_ENTRY_SSL}}
server {
    listen 80;
    server_name {{KNOT_DOMAIN}};

    location /.well-known/acme-challenge/ {
        root {{KNOT_ENTRY_WEB_ROOT}};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
{{/KNOT_ENTRY_SSL}}
