.DS_Store
.env
.env.*
!.env.example
node_modules/
# 构建产物与运行时数据按项目写死：裸 dist/、var/ 会把同名的源码目录和测试夹具一起吞掉，
# 被忽略时 git 不报错，等发现时文件已经从版本库里消失了（S02-08）。
knot-platform/web/dist/
xknot.si/web/dist/
knot-platform/var/
xknot.si/var/
build/
__pycache__/
*.pyc
.venv/
venv/
.idea/
.vscode/
# 日志只出现在各项目的 var/log 与仓库根；不按扩展名全仓忽略，免得测试夹具 .log 静默消失。
/*.log
data/uploads/
# 数据库文件与备份：不限目录。转储存量随部署变化，放到仓库任何位置都不进版本库。
# 不忽略普通 *.sql——迁移（backend/migrations/）与审计用的建表快照要进仓库。
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*dump*.sql
*.sql.gz
*.tar.gz
pg_backup*/
# 开发日志只在本机写、只发到 wang.xknot.si，不进 GitHub
blog/

# 本地截图与预览产物，只在本机看，不进仓库
.tmp-review/
# 同步工具产生的冲突副本与手工备份，只留本机
*.sync-conflict-*
*.bak
*.bak-*
# 站点配置：只有模板进版本库。真实站点目录（bot01 这类开发者自己的实例）
# 只留在本机，不进仓库、不进发布包；本机服务覆盖写 *.local.env。
# xknot.env 是中枢签发的接入凭据，同样只留本机。
knot-platform/sites/*
!knot-platform/sites/_template/
*.local.env

# 发布包只留本机
knot-platform/artifacts/
knot-platform/releases/
# local 站点把仓库当部署根，这两个是 deploy-site.sh 的产物
knot-platform/current
knot-platform/deployed.json

# 端到端产物：失败截图、trace 与 HTML 报告只在本机看
xknot.si/e2e/report/
xknot.si/e2e/test-results/
