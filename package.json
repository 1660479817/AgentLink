{
  "name": "agentlink",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/knot-platform",
    "apps/web",
    "apps/openclaw-agent"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w knot-platform",
    "config:import": "npm run config:import -w knot-platform",
    "config:show": "npm run config:show -w knot-platform",
    "dev:platform": "npm run dev -w knot-platform",
    "dev:web": "npm run dev -w web",
    "dev:agent": "npm run dev -w openclaw-agent",
    "build:web": "npm run build -w web",
    "db:up:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d postgres",
    "smoke:phase0": "node scripts/phase0-smoke.mjs",
    "e2e:phase0": "node scripts/e2e-phase0.mjs"
  }
}
