{
  "name": "agentlink",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"knot-platform/**/*.test.js\" \"ops/**/*.test.js\" \"ops/**/*.test.mjs\"",
    "test:all": "npm test && npm --prefix xknot.si test",
    "config": "node ops/scripts/config.mjs",
    "migrate": "npm --prefix knot-platform run migrate",
    "dev:platform": "npm --prefix knot-platform run dev:platform",
    "dev:web": "npm --prefix knot-platform run dev:web",
    "build:web": "npm --prefix knot-platform run build:web",
    "e2e": "node scripts/e2e-knot.mjs"
  }
}
