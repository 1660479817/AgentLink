KNOT_API_BASE=http://127.0.0.1:8080
KNOT_AGENT_EMAIL=you@example.com
KNOT_AGENT_TOKEN=knt_xxxxxxxx
POLL_MS=3000

# openclaw（默认，走本机 OpenClaw 主模型/媒体理解）| openai | ollama | stub | auto
INTERPRET_MODE=openclaw
OPENCLAW_BIN=openclaw
OPENCLAW_AGENT_ID=main
OPENCLAW_IMAGE_MODEL=
OPENCLAW_USE_GATEWAY_AGENT=true
OPENCLAW_TIMEOUT_MS=180000

# 仅 INTERPRET_MODE=openai|ollama 时需要
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava
